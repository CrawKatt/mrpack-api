# ============================================================================
# Mrpack API - Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ----------------------------------------------------------------------------
# Admin Authentication
# ----------------------------------------------------------------------------
# REQUIRED: Set your admin username (minimum 3 characters)
ADMIN_USERNAME=admin

# REQUIRED: Generate a password hash using:
#   cargo run --bin hash_password "YourPassword"
# Then paste the hash here BETWEEN SINGLE QUOTES:
ADMIN_PASSWORD_HASH=''

# Example hash format (DO NOT USE THIS - generate your own):
# ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
#
# IMPORTANT: Use single quotes to prevent shell variable expansion!

# ----------------------------------------------------------------------------
# Launcher Download Token
# ----------------------------------------------------------------------------
# Optional but recommended: generate a separate token for the launcher using:
#   cargo run --bin hash_password "LongRandomLauncherToken"
# The launcher sends the raw token with:
#   Authorization: Bearer LongRandomLauncherToken
DOWNLOAD_TOKEN_HASH=''

# ----------------------------------------------------------------------------
# Storage Configuration
# ----------------------------------------------------------------------------
# Local directory for metadata, sessions, crash reports and the temporary mrpack cache
STORAGE_DIR=storage

# Maximum file size in megabytes (1-10240)
MAX_FILE_SIZE_MB=2048

# Cloudflare R2 (S3-compatible storage for the canonical .mrpack files)
# Set R2_ENABLED=true and fill all values to make R2 canonical; STORAGE_DIR
# will keep only metadata, media and a temporary cache for ZIP editing.
R2_ENABLED=false
# Use either R2_ENDPOINT or R2_ACCOUNT_ID. The endpoint is usually:
# https://<account-id>.r2.cloudflarestorage.com
#
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_BUCKET=pixel-launcher
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional object prefix inside the bucket (for example: mrpacks)
R2_PREFIX=mrpacks

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------
# Set to true in production to enforce HTTPS checks
REQUIRE_HTTPS=false

# Set to true only when the API is behind a trusted reverse proxy that overwrites
# X-Forwarded-* headers. Required if REQUIRE_HTTPS=true behind nginx/traefik.
TRUST_PROXY_HEADERS=false

# CORS: comma-separated list of allowed origins.
# Leave empty to disable cross-origin browser access.
# Use * only for local testing.
# Example: ALLOWED_ORIGINS=https://example.com,https://app.example.com
ALLOWED_ORIGINS=

# Max crash report body size in bytes (default 2MB, max 20MB)
MAX_CRASH_REPORT_BYTES=2097152

# ----------------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------------
# Set to "production" in production environments
# This enables additional security warnings and checks
# In production, DOWNLOAD_TOKEN_HASH is required or the server refuses to start.
RUST_ENV=development

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# Log level: error, warn, info, debug, trace
# For production, use: info or warn
# For development, use: debug or trace
RUST_LOG=info

# Or configure per-module:
# RUST_LOG=mrpack_api=debug,tower_http=info,axum=info

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# 
# [ ] ADMIN_USERNAME is set to a non-default value
# [ ] ADMIN_PASSWORD_HASH is generated with a strong password (12+ chars)
# [ ] DOWNLOAD_TOKEN_HASH is generated for the private launcher
# [ ] REQUIRE_HTTPS is set to true
# [ ] TRUST_PROXY_HEADERS is true only behind a trusted proxy
# [ ] ALLOWED_ORIGINS is configured with specific domains
# [ ] RUST_ENV is set to "production"
# [ ] RUST_LOG is set to "info" or "warn"
# [ ] MAX_FILE_SIZE_MB is appropriate for your use case
# [ ] R2_ENABLED=true and R2 credentials are configured for mrpack storage
# [ ] R2 access keys are scoped to the required bucket only
# [ ] .env file is NOT in version control
# [ ] File permissions on .env are restricted (chmod 600)
# [ ] Server is behind a reverse proxy with SSL/TLS
# [ ] Firewall is properly configured
# [ ] R2 bucket versioning/backups are configured
#
# ============================================================================

# ============================================================================
# QUICK START
# ============================================================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate password hash:
#    cargo run --bin hash-password "YourSecurePassword123!"
#
# 3. Edit .env and set ADMIN_USERNAME, ADMIN_PASSWORD_HASH, and DOWNLOAD_TOKEN_HASH
#
# 4. Start the server:
#    cargo run --release
#
# ============================================================================
